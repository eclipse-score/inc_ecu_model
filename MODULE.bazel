module(name = "score_ecu_model")

# Dependencies that will get propagated to our users as transitive dependencies
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "31.1")
bazel_dep(name = "rules_python", version = "1.8.5")

# Dependencies required for development & testing that will not get propagated to our users as transitive dependencies
bazel_dep(name = "score_tooling", version = "2.0.1", dev_dependency = True)
bazel_dep(name = "aspect_rules_lint", version = "2.9.1", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1", dev_dependency = True)
bazel_dep(name = "rules_go", version = "0.61.1", dev_dependency = True)
bazel_dep(name = "rules_proto", version = "7.1.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)
bazel_dep(name = "toolchains_protoc", version = "0.6.1", dev_dependency = True)

protoc = use_extension("@toolchains_protoc//protoc:extensions.bzl", "protoc", dev_dependency = True)
protoc.toolchain(
    google_protobuf = "com_google_protobuf",
    version = "v29.5",
)
use_repo(protoc, "com_google_protobuf", "toolchains_protoc_hub")

register_toolchains(
    "@toolchains_protoc_hub//:all",
    dev_dependency = True,
)

# Toolchains required for development & testing that will not get propagated to our users as transitive dependencies
python = use_extension("@rules_python//python/extensions:python.bzl", "python", dev_dependency = True)
python.toolchain(
    configure_coverage_tool = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "pypi")
